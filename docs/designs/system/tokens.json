{
  "$meta": {
    "name": "Pockito Design System",
    "version": "0.1.0",
    "derivedFrom": [
      "designs/pockito-logo-horizontal-light.svg",
      "designs/pockito-logo-horizontal-dark.svg",
      "designs/favicon.svg",
      "designs/HOME-IMAGEGEN-FLAT-PROOF.png"
    ],
    "note": "Primitive colour values are anchored to the hand-authored SVG logos, which decode exactly onto Tailwind's palette (indigo-600, cyan-500, amber-400, slate-900). The PNG proof is treated as direction, not source: its blues drift to #3546E5 / #1D2AE8, which are render artifacts.",
    "unit": "px unless noted"
  },
  "color": {
    "primitive": {
      "slate": {
        "50": "#F8FAFC",
        "100": "#F1F5F9",
        "200": "#E2E8F0",
        "300": "#CBD5E1",
        "400": "#94A3B8",
        "500": "#64748B",
        "600": "#475569",
        "700": "#334155",
        "800": "#1E293B",
        "900": "#0F172A",
        "950": "#020617"
      },
      "indigo": {
        "50": "#EEF2FF",
        "100": "#E0E7FF",
        "200": "#C7D2FE",
        "300": "#A5B4FC",
        "400": "#818CF8",
        "500": "#6366F1",
        "600": "#4F46E5",
        "700": "#4338CA",
        "800": "#3730A3",
        "900": "#312E81",
        "950": "#1E1B4B"
      },
      "cyan": {
        "50": "#ECFEFF",
        "100": "#CFFAFE",
        "200": "#A5F3FC",
        "300": "#67E8F9",
        "400": "#22D3EE",
        "500": "#06B6D4",
        "600": "#0891B2",
        "700": "#0E7490"
      },
      "amber": {
        "50": "#FFFBEB",
        "100": "#FEF3C7",
        "200": "#FDE68A",
        "300": "#FCD34D",
        "400": "#FBBF24",
        "500": "#F59E0B",
        "600": "#D97706",
        "700": "#B45309"
      },
      "emerald": {
        "50": "#ECFDF5",
        "100": "#D1FAE5",
        "400": "#34D399",
        "500": "#10B981",
        "600": "#059669",
        "700": "#047857"
      },
      "rose": {
        "50": "#FFF1F2",
        "100": "#FFE4E6",
        "400": "#FB7185",
        "500": "#F43F5E",
        "600": "#E11D48",
        "700": "#BE123C"
      },
      "white": "#FFFFFF",
      "black": "#000000"
    },
    "brand": {
      "primary": {
        "value": "{color.primitive.indigo.600}",
        "hex": "#4F46E5",
        "note": "The mark's gradient start. Primary actions, links, active nav."
      },
      "primaryHover": {
        "value": "{color.primitive.indigo.700}",
        "hex": "#4338CA"
      },
      "primaryPressed": {
        "value": "{color.primitive.indigo.800}",
        "hex": "#3730A3"
      },
      "primarySubtle": {
        "value": "{color.primitive.indigo.50}",
        "hex": "#EEF2FF"
      },
      "secondary": {
        "value": "{color.primitive.cyan.500}",
        "hex": "#06B6D4",
        "note": "Gradient end only. Never a standalone UI colour."
      },
      "accent": {
        "value": "{color.primitive.amber.400}",
        "hex": "#FBBF24",
        "note": "The coin in the mark. Reserved for money-in-motion and shared finance — see semantic.shared."
      },
      "ink": {
        "value": "{color.primitive.slate.900}",
        "hex": "#0F172A",
        "note": "Wordmark colour on light backgrounds."
      },
      "gradient": {
        "from": "#4F46E5",
        "to": "#06B6D4",
        "angle": "135deg",
        "css": "linear-gradient(135deg, #4F46E5 0%, #06B6D4 100%)",
        "note": "App mark and marketing surfaces only. Never behind body text."
      }
    },
    "semantic": {
      "bg": {
        "page": {
          "light": "#F8FAFC",
          "dark": "#020617"
        },
        "surface": {
          "light": "#FFFFFF",
          "dark": "#0F172A"
        },
        "raised": {
          "light": "#FFFFFF",
          "dark": "#1E293B"
        },
        "sunken": {
          "light": "#F1F5F9",
          "dark": "#020617"
        },
        "hero": {
          "light": "#4F46E5",
          "dark": "#4F46E5",
          "note": "The saturated card that carries the month's headline figure."
        },
        "inverse": {
          "light": "#0F172A",
          "dark": "#F8FAFC"
        }
      },
      "text": {
        "primary": {
          "light": "#0F172A",
          "dark": "#F8FAFC"
        },
        "secondary": {
          "light": "#475569",
          "dark": "#94A3B8"
        },
        "tertiary": {
          "light": "#64748B",
          "dark": "#94A3B8",
          "note": "slate-500, not slate-400 — slate-400 measures 2.56:1 on white and fails body text."
        },
        "disabled": {
          "light": "#94A3B8",
          "dark": "#64748B",
          "note": "The only legitimate use of slate-400 on light: disabled state, which is exempt from contrast minimums."
        },
        "inverse": {
          "light": "#FFFFFF",
          "dark": "#0F172A"
        },
        "link": {
          "light": "#4F46E5",
          "dark": "#818CF8"
        },
        "onHero": {
          "light": "#FFFFFF",
          "dark": "#FFFFFF"
        },
        "onHeroMuted": {
          "light": "rgba(255,255,255,0.72)",
          "dark": "rgba(255,255,255,0.72)"
        }
      },
      "border": {
        "subtle": {
          "light": "#E2E8F0",
          "dark": "#1E293B"
        },
        "default": {
          "light": "#CBD5E1",
          "dark": "#334155"
        },
        "strong": {
          "light": "#94A3B8",
          "dark": "#475569"
        },
        "focus": {
          "light": "#4F46E5",
          "dark": "#818CF8"
        }
      },
      "shared": {
        "$note": "Amber is the shared-money channel. It marks that an amount belongs to more than one person — the share rule, the owed nudge, the space avatar, the budget bar. Direction (owed vs owing) is carried by semantic.balance, never by amber alone.",
        "default": {
          "light": "#FBBF24",
          "dark": "#FBBF24",
          "note": "Fills, marks and rules only. Measures 1.67:1 on white — never legal as text."
        },
        "strong": {
          "light": "#B45309",
          "dark": "#FCD34D",
          "note": "amber-700, not amber-600 — amber-600 measures 3.07:1 on the amber surface and fails body text."
        },
        "surface": {
          "light": "#FFFBEB",
          "dark": "#3E2E0B"
        },
        "border": {
          "light": "#FDE68A",
          "dark": "#78500B"
        }
      },
      "balance": {
        "$note": "Direction of a shared balance. Owing money is not an error, so it is amber-warm, never danger-red.",
        "owedToYou": {
          "light": "#047857",
          "dark": "#34D399",
          "note": "emerald-700, not emerald-600 — emerald-600 measures 3.77:1 on white and fails body text, and balance amounts are body-size."
        },
        "youOwe": {
          "light": "#B45309",
          "dark": "#FCD34D"
        },
        "settled": {
          "light": "#64748B",
          "dark": "#94A3B8"
        }
      },
      "feedback": {
        "success": {
          "light": "#047857",
          "dark": "#34D399",
          "surface": {
            "light": "#ECFDF5",
            "dark": "#052E20"
          }
        },
        "warning": {
          "light": "#B45309",
          "dark": "#FCD34D",
          "surface": {
            "light": "#FFFBEB",
            "dark": "#3E2E0B"
          }
        },
        "danger": {
          "light": "#E11D48",
          "dark": "#FB7185",
          "surface": {
            "light": "#FFF1F2",
            "dark": "#4C0519"
          }
        },
        "info": {
          "light": "#4F46E5",
          "dark": "#818CF8",
          "surface": {
            "light": "#EEF2FF",
            "dark": "#1E1B4B"
          }
        }
      },
      "category": {
        "$note": "Deterministic palette for category and account marks. Assigned by index, never by meaning.",
        "1": "#10B981",
        "2": "#4F46E5",
        "3": "#06B6D4",
        "4": "#FBBF24",
        "5": "#F43F5E",
        "6": "#8B5CF6",
        "7": "#F59E0B",
        "8": "#0EA5E9",
        "9": "#EC4899",
        "10": "#64748B",
        "11": "#14B8A6",
        "12": "#A855F7"
      }
    }
  },
  "typography": {
    "family": {
      "sans": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif",
      "mono": "'SF Mono', ui-monospace, 'Roboto Mono', Menlo, monospace",
      "$note": "Inter is the brand face, stated in the logo SVGs. Money uses sans with tabular figures; mono is for codes, rates and IDs only."
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    },
    "scale": {
      "display": {
        "size": 40,
        "lineHeight": 44,
        "weight": 800,
        "tracking": "-0.02em",
        "use": "Hero figure — net worth, month total"
      },
      "h1": {
        "size": 28,
        "lineHeight": 34,
        "weight": 700,
        "tracking": "-0.02em",
        "use": "Screen title"
      },
      "h2": {
        "size": 22,
        "lineHeight": 28,
        "weight": 700,
        "tracking": "-0.01em",
        "use": "Greeting, large amounts"
      },
      "h3": {
        "size": 17,
        "lineHeight": 24,
        "weight": 600,
        "tracking": "0",
        "use": "Section header"
      },
      "bodyLarge": {
        "size": 16,
        "lineHeight": 24,
        "weight": 400,
        "tracking": "0"
      },
      "body": {
        "size": 15,
        "lineHeight": 22,
        "weight": 400,
        "tracking": "0",
        "use": "Row title at weight 500"
      },
      "bodySmall": {
        "size": 13,
        "lineHeight": 18,
        "weight": 400,
        "tracking": "0",
        "use": "Row subtitle"
      },
      "caption": {
        "size": 12,
        "lineHeight": 16,
        "weight": 400,
        "tracking": "0"
      },
      "overline": {
        "size": 11,
        "lineHeight": 14,
        "weight": 600,
        "tracking": "0.08em",
        "transform": "uppercase"
      }
    },
    "money": {
      "$note": "Every monetary figure uses tabular figures so columns align. Never let a money value fall back to proportional numerals.",
      "fontFeatureSettings": "'tnum' 1, 'cv01' 1",
      "fontVariantNumeric": "tabular-nums"
    }
  },
  "space": {
    "$base": 4,
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "7": 28,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "20": 80,
    "$note": "Screen gutter is space.4 (16). Section gap is space.6 (24). Card padding is space.4."
  },
  "radius": {
    "none": 0,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "2xl": 24,
    "full": 9999,
    "$note": "Cards use lg (16). The hero uses xl (20). The app mark uses 22% of its size, matching the favicon's 28/128."
  },
  "elevation": {
    "none": "none",
    "sm": "0 1px 2px 0 rgba(15,23,42,0.05)",
    "md": "0 4px 12px -2px rgba(15,23,42,0.08), 0 2px 4px -2px rgba(15,23,42,0.04)",
    "lg": "0 12px 24px -6px rgba(15,23,42,0.12), 0 4px 8px -4px rgba(15,23,42,0.06)",
    "fab": "0 8px 20px -4px rgba(251,191,36,0.44)",
    "$note": "Cards are defined by a border in light mode and elevation only when they float. The FAB's shadow is tinted by its own colour."
  },
  "motion": {
    "duration": {
      "instant": 0,
      "fast": 150,
      "base": 250,
      "slow": 350,
      "deliberate": 500
    },
    "easing": {
      "standard": "cubic-bezier(0.4, 0, 0.2, 1)",
      "decelerate": "cubic-bezier(0, 0, 0.2, 1)",
      "accelerate": "cubic-bezier(0.4, 0, 1, 1)",
      "sheet": "cubic-bezier(0.32, 0.72, 0, 1)"
    },
    "$note": "Sheets use motion.sheet at duration.base. All motion degrades to a cross-fade under prefers-reduced-motion."
  },
  "size": {
    "touchTarget": 44,
    "rowHeight": {
      "single": 56,
      "double": 64,
      "triple": 72,
      "action": 80
    },
    "icon": {
      "sm": 16,
      "md": 20,
      "lg": 24,
      "xl": 32
    },
    "avatar": {
      "xs": 24,
      "sm": 32,
      "md": 40,
      "lg": 48,
      "xl": 64
    },
    "mark": {
      "sm": 32,
      "md": 40,
      "lg": 56
    },
    "fab": 56,
    "navHeight": 64,
    "headerHeight": 56
  },
  "component": {
    "shareRule": {
      "$note": "The signature notation. A hairline beneath a shared amount, filled in accent to the proportion that belongs to the current user. Reading the fill gives the split without reading the numbers.",
      "height": 2,
      "radius": 2,
      "track": "{color.semantic.border.subtle}",
      "fill": "{color.semantic.shared.default}",
      "minFillPercent": 4,
      "widths": {
        "row": 64,
        "hero": "100%",
        "detail": "100%"
      }
    },
    "card": {
      "radius": "{radius.lg}",
      "padding": "{space.4}",
      "background": "{color.semantic.bg.surface}",
      "border": "1px solid {color.semantic.border.subtle}",
      "elevation": "{elevation.none}"
    },
    "hero": {
      "radius": "{radius.xl}",
      "padding": "{space.5}",
      "background": "{color.semantic.bg.hero}",
      "text": "{color.semantic.text.onHero}"
    },
    "button": {
      "height": {
        "sm": 36,
        "md": 44,
        "lg": 52
      },
      "radius": "{radius.md}",
      "paddingX": "{space.5}",
      "variants": [
        "primary",
        "secondary",
        "tertiary",
        "destructive",
        "accent"
      ]
    },
    "progress": {
      "height": 8,
      "radius": "{radius.full}",
      "track": "{color.semantic.bg.sunken}",
      "fillDefault": "{color.brand.primary}",
      "fillNearLimit": "{color.semantic.shared.default}",
      "fillOver": "{color.semantic.feedback.danger}",
      "$note": "A space budget uses the shared accent; a personal budget uses brand primary."
    }
  },
  "a11y": {
    "minContrastBody": 4.5,
    "minContrastLarge": 3.0,
    "minTouchTarget": 44,
    "$note": "Colour is never the only signal. Balance direction always carries a text label; budget status always carries a value.",
    "measured": {
      "$note": "Computed, not estimated. Three primitives were rejected during this pass for failing body text: slate-400 as tertiary text (2.56), emerald-600 as owedToYou (3.77), amber-600 as shared.strong on the amber surface (3.07).",
      "text.primary on bg.page": 17.06,
      "text.secondary on bg.surface": 7.58,
      "text.tertiary on bg.surface": 4.76,
      "text.tertiary on bg.page": 4.55,
      "text.onHero on bg.hero": 6.29,
      "text.link on bg.surface": 6.29,
      "balance.owedToYou on bg.surface": 5.48,
      "balance.youOwe on bg.surface": 5.02,
      "feedback.danger on bg.surface": 4.7,
      "shared.strong on shared.surface": 4.84,
      "dark text.primary on dark bg.page": 19.28,
      "dark link on dark bg.surface": 5.98,
      "dark owedToYou on dark bg.raised": 7.61,
      "dark youOwe on dark bg.raised": 10.15,
      "shared.default as text on white": 1.67
    }
  },
  "iconography": {
    "$note": "Geometry follows Material Symbols Rounded — the set life-os-mobile already uses via Flutter's Icons.* (outlined for objects, rounded for chrome). Shipped as an SVG sprite of stroked paths so one set serves every size and colour.",
    "source": "designs/system/icons.svg",
    "grid": 24,
    "strokeWidth": {
      "default": 2,
      "xs": 2.3,
      "sm": 2.1,
      "lg": 1.9
    },
    "strokeLinecap": "round",
    "strokeLinejoin": "round",
    "fill": "none",
    "color": "currentColor",
    "sizes": {
      "xs": 16,
      "sm": 20,
      "md": 24,
      "lg": 28
    },
    "variants": {
      "outlined": "Default. Every object, every chrome affordance.",
      "filled": "Only the active bottom-nav item and category circles. Never elsewhere."
    },
    "rules": [
      "Never use emoji as an icon — platform-dependent and off-brand.",
      "Never use a currency glyph as an icon: income and expense are drawn as direction, because a '$' would be wrong in a multi-currency product.",
      "A category icon always sits in a circle tinted from color.semantic.category, assigned by index.",
      "Icons inherit currentColor; they are never given a hardcoded fill."
    ],
    "sets": {
      "navigation": [
        "home",
        "wallet",
        "spaces",
        "activity",
        "plus"
      ],
      "chrome": [
        "bell",
        "chevron-right",
        "chevron-down",
        "arrow-left",
        "close",
        "check",
        "search",
        "filter",
        "more",
        "tune",
        "info",
        "warning",
        "trash",
        "edit",
        "calendar",
        "link",
        "shield",
        "sparkle"
      ],
      "finance": [
        "receipt",
        "transfer",
        "settle",
        "budget",
        "repeat",
        "card",
        "bank",
        "cash",
        "savings",
        "currency",
        "person",
        "person-add",
        "income",
        "expense"
      ],
      "category": [
        "cart",
        "restaurant",
        "transit",
        "housing",
        "utilities",
        "health",
        "shopping",
        "entertainment",
        "travel",
        "education",
        "gift"
      ]
    }
  }
}